---
// src/layouts/Layout.astro
import "../styles/global.css";
export interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="m-0 p-0">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/Coronadorada.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Forzar esquema de color claro -->
    <meta name="color-scheme" content="only light" />
    <meta name="theme-color" content="#ffffff" />

    <title>{title}</title>
    <!-- Vista previa de WhatsApp: solo la imagen, sin texto -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://mis-xv-jeysi-jazmin-2026.vercel.app/" />
    <meta property="og:title" content="&#8203;" />
    <meta property="og:image" content="https://mis-xv-jeysi-jazmin-2026.vercel.app/og-image.jpg" />
    <meta property="og:image:secure_url" content="https://mis-xv-jeysi-jazmin-2026.vercel.app/og-image.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://mis-xv-jeysi-jazmin-2026.vercel.app/og-image.jpg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Crimson+Text:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Crimson+Text:wght@400;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Charm:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      /* Forzar modo claro - sobrescribir preferencias del sistema */
      html {
        width: 100%;
        height: 100%;
        overflow-x: hidden;
        color-scheme: only light;
        -webkit-color-scheme: only light;
      }

      body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100vh;
        overflow-x: hidden;
        background-image: url("/imagenes/fondoceleste.webp");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
        color-scheme: only light;
        -webkit-color-scheme: only light;
      }

      main {
        background: transparent !important;
      }

      /* Prevenir inversión de colores en modo oscuro */
      * {
        color-scheme: only light;
      }

      /* Forzar colores originales en todos los elementos */
      *:not(svg):not(path) {
        -webkit-filter: none !important;
        filter: none !important;
      }
    </style>
  </head>
  <body class="min-h-screen m-0 p-0">
    <main class="m-0 p-0 overflow-x-hidden">
      <slot />
    </main>
  </body>
</html>
